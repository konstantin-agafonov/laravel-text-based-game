							"pm.sendRequest({",
							"     url: 'http://localhost:8100/sanctum/csrf-cookie',",
							"     method: 'GET'",
							" }, function(error, response, {cookies}) {",
							"     if(!error){",
							"         pm.environment.set('xsrf-cookie', cookies.get('XSRF-TOKEN').slice(0,-1))",
							"     }    ",
							"})"
