		{
			"name": "Login",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.sendRequest({",
							"    url: pm.collectionVariables.get('url') + '/sanctum/csrf-cookie',",
							"    method: \"GET\"",
							"}, function(error, response, { cookies }) {",
							"    if (error) {",
							"        console.log(error);",
							"        return;",
							"    }",
							"",
							"    pm.collectionVariables.set('xsrf', cookies.get('XSRF-TOKEN'));",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disabledSystemHeaders": {
					"accept": true
				}
			},
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "X-XSRF-TOKEN",
						"value": "{{xsrf}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"secret\"\n}"
				},
				"url": {
					"raw": "http://localhost:8100/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8100",
					"path": [
